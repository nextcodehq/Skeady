{
  "name": "skeady",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint src vite.config.ts",
    "i18n:compile": "paraglide-js compile --project ../../packages/i18n/project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "vite build",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.29.0",
    "@skeady/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@skeady/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
