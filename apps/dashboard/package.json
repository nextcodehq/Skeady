{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "lint": "oxlint src vite.config.ts",
    "i18n:compile": "paraglide-js compile --project ../../packages/i18n/project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "vite build",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.29.1",
    "@skeady/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
