{
  "name": "skeady-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:rust": "cargo fmt --manifest-path apps/skeady/src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path apps/skeady/src-tauri/Cargo.toml --all -- --check",
    "tauri:dev": "bun --filter skeady tauri dev",
    "tauri:build": "bun --filter skeady tauri build",
    "prepare": "husky",
    "cm": "cz",
    "check": "bun run format:check && bun run format:rust:check && turbo run lint check-types build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "packageManager": "bun@1.4.2"
}
