{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".editorconfig",
    ".gitattributes",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    "packages/tsconfig/**",
    "packages/i18n/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["VITE_API_URL", "VITE_APP_NAME"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "i18n:compile": {
      "outputs": ["src/paraglide/**"]
    },
    "generate-routes": {
      "outputs": ["src/routeTree.gen.ts"]
    }
  }
}
